#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo "run as root" >&2; exit 1; }
[[ $# -ge 1 ]] || { echo "Usage: obsi-configure-vfio PCI_BDF [PCI_BDF...]" >&2; exit 2; }

declare -a ids=()
declare -A requested=()
group=""

for raw in "$@"; do
  bdf=${raw#0000:}
  [[ $bdf =~ ^[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}\.[0-7]$ ]] || {
    echo "invalid PCI address: $raw" >&2
    exit 1
  }
  full="0000:$bdf"
  device="/sys/bus/pci/devices/$full"
  [[ -d $device ]] || { echo "PCI device not found: $full" >&2; exit 1; }
  [[ -L $device/iommu_group ]] || { echo "IOMMU is not active for $full" >&2; exit 1; }
  this_group=$(basename "$(readlink -f "$device/iommu_group")")
  [[ -z $group || $group == "$this_group" ]] || {
    echo "requested devices span IOMMU groups; configure each complete group deliberately" >&2
    exit 1
  }
  group=$this_group
  vendor=$(<"$device/vendor")
  product=$(<"$device/device")
  ids+=("${vendor#0x}:${product#0x}")
  requested[$full]=1
done

missing=()
for member in /sys/kernel/iommu_groups/"$group"/devices/*; do
  full=$(basename "$member")
  class=$(<"$member/class")
  # PCI bridges do not need vfio-pci binding. Every endpoint does.
  [[ ${class:2:2} == 06 ]] && continue
  [[ -n ${requested[$full]:-} ]] || missing+=("$full")
done
if ((${#missing[@]})); then
  printf 'IOMMU group %s also contains unselected endpoint(s): %s\n' \
    "$group" "${missing[*]}" >&2
  echo "Refusing partial-group passthrough." >&2
  exit 1
fi

joined=$(IFS=,; echo "${ids[*]}")

# vfio-pci.ids matches vendor:device globally. Refuse a profile that would also
# steal an identical host GPU or endpoint outside the selected group.
duplicates=()
for candidate in /sys/bus/pci/devices/*; do
  candidate_bdf=$(basename "$candidate")
  [[ -n ${requested[$candidate_bdf]:-} ]] && continue
  candidate_id="$(<"$candidate/vendor")"
  candidate_id="${candidate_id#0x}:$(sed 's/^0x//' "$candidate/device")"
  for selected_id in "${ids[@]}"; do
    [[ $candidate_id == "$selected_id" ]] && duplicates+=("$candidate_bdf=$candidate_id")
  done
done
if ((${#duplicates[@]})); then
  printf 'vfio-pci.ids would also capture: %s\n' "${duplicates[*]}" >&2
  echo "Use a BDF-specific initramfs driver_override profile instead." >&2
  exit 1
fi

install -d -m 0755 /etc/modprobe.d /etc/initramfs-tools /etc/obsi
cat >/etc/modprobe.d/obsi-vfio.conf <<EOF
options vfio-pci ids=$joined
softdep nouveau pre: vfio-pci
softdep nvidia pre: vfio-pci
softdep amdgpu pre: vfio-pci
EOF
for module in vfio vfio_iommu_type1 vfio_pci; do
  grep -qxF "$module" /etc/initramfs-tools/modules 2>/dev/null || echo "$module" >>/etc/initramfs-tools/modules
done

temporary=$(mktemp /etc/obsi/gpu.json.XXXXXX)
{
  printf '{\n  "mode": "dedicated",\n  "iommu_group": "%s",\n  "devices": [' "$group"
  separator=""
  for full in "${!requested[@]}"; do
    printf '%s"%s"' "$separator" "$full"
    separator=", "
  done
  printf ']\n}\n'
} >"$temporary"
chmod 0640 "$temporary"
mv -f "$temporary" /etc/obsi/gpu.json
update-initramfs -u

echo "VFIO profile written for IOMMU group $group ($joined); reboot required."
