#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C

if ! virsh net-info default >/dev/null 2>&1; then
  echo "obsi-network: libvirt default network is not installed" >&2
  exit 1
fi

virsh net-autostart default
if ! virsh net-info default | awk -F: '$1 ~ /Active/ {gsub(/ /, "", $2); exit !($2 == "yes")}' ; then
  virsh net-start default
fi
