#!/usr/bin/env python3
"""libvirt prepare hook: enforce V1 thin-pool policy and activate the VM LV."""

from __future__ import annotations

import argparse
import json
import logging
import subprocess
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("machine")
    parser.add_argument("--config-root", type=Path, default=Path("/etc/obsi/machines"))
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    if not args.machine or any(
        c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
        for c in args.machine
    ):
        parser.error("invalid machine name")

    logging.basicConfig(level=logging.INFO, format="obsi-prestart: %(message)s")
    config_path = args.config_root / f"{args.machine}.json"
    try:
        config = json.loads(config_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        logging.error("cannot read %s: %s", config_path, exc)
        return 1

    if config.get("backend") != "lvmthin":
        logging.error("%s is not a V1 lvmthin machine", args.machine)
        return 1
    expected = f"/dev/obsi-vg/vm-{args.machine}"
    if config.get("disk") != expected:
        logging.error("machine disk must be %s", expected)
        return 1

    command = ["/usr/bin/obsi-storage", "can-start"]
    if not args.dry_run:
        command = ["/usr/bin/obsi-storage", "activate-machine", args.machine]
    result = subprocess.run(command, check=False)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())

