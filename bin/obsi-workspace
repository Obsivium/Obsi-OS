#!/usr/bin/env bash
set -Eeuo pipefail

export LC_ALL=C
RUNTIME_DIR=${OBSI_RUNTIME_DIR:-/run/obsi}
ACTIVE_FILE="$RUNTIME_DIR/active-machine"
TIMEOUT_SECONDS=${OBSI_HIBERNATE_TIMEOUT:-90}

die() { printf 'obsi-workspace: %s\n' "$*" >&2; exit 1; }
valid_name() { [[ $1 =~ ^[A-Za-z0-9_-]+$ ]]; }
active_machine() { [[ -f $ACTIVE_FILE ]] && tr -d '\r\n' <"$ACTIVE_FILE" || true; }
domain_state() { virsh domstate "$1" 2>/dev/null | tr '[:upper:]' '[:lower:]' | xargs; }

set_active() {
  local machine=$1 temporary
  install -d -m 0755 "$RUNTIME_DIR"
  temporary="$ACTIVE_FILE.$$"
  printf '%s\n' "$machine" >"$temporary"
  mv -f "$temporary" "$ACTIVE_FILE"
}

clear_active_if() {
  local machine=$1
  [[ $(active_machine) == "$machine" ]] && rm -f -- "$ACTIVE_FILE"
}

usage() {
  echo "Usage: obsi-workspace start|hibernate|status MACHINE"
}

[[ $# -eq 2 ]] || { usage; exit 2; }
action=$1 machine=$2
valid_name "$machine" || die "invalid machine name"
command -v virsh >/dev/null || die "virsh is not installed"
command -v flock >/dev/null || die "flock is not installed"
install -d -m 0755 "$RUNTIME_DIR"
exec 9>"$RUNTIME_DIR/workspace.lock"
flock -x 9

case "$action" in
  start)
    current=$(active_machine)
    [[ -z $current || $current == "$machine" ]] || die "$current already owns the workstation devices"
    state=$(domain_state "$machine")
    set_active "$machine"
    if [[ $state == *"pmsuspended"* || $state == *"suspended"* ]]; then
      if ! virsh dompmwakeup "$machine"; then
        clear_active_if "$machine"
        die "could not wake $machine"
      fi
    elif [[ $state == "running" || $state == "blocked" ]]; then
      :
    else
      if ! virsh start "$machine"; then
        clear_active_if "$machine"
        die "could not start $machine"
      fi
    fi
    ;;
  hibernate)
    [[ $(active_machine) == "$machine" ]] || die "$machine is not the active workspace"
    state=$(domain_state "$machine")
    [[ $state == "running" || $state == "blocked" ]] || die "$machine is not running ($state)"

    # QGA intentionally does not reply after a successful suspend-to-disk.
    if command -v timeout >/dev/null; then
      timeout 20s virsh dompmsuspend "$machine" --target disk || {
        code=$?
        [[ $code -eq 124 ]] || die "guest rejected S4 hibernation"
      }
    else
      virsh dompmsuspend "$machine" --target disk || die "guest rejected S4 hibernation"
    fi

    deadline=$((SECONDS + TIMEOUT_SECONDS))
    while (( SECONDS < deadline )); do
      state=$(domain_state "$machine")
      case "$state" in
        "shut off")
          clear_active_if "$machine"
          exit 0
          ;;
      esac
      sleep 1
    done
    die "S4 did not complete in ${TIMEOUT_SECONDS}s; VM was left running"
    ;;
  status)
    printf 'active=%s state=%s\n' "$(active_machine)" "$(domain_state "$machine")"
    ;;
  *) usage; exit 2 ;;
esac
